# Django Backend Configuration
SECRET_KEY=django-insecure-change-this-in-production-random-key-32-chars
DEBUG=True
ALLOWED_HOSTS=.teamproject.deep-technologies.com,.localhost,127.0.0.1,localhost

# Database PostgreSQL (django-tenants requires postgres)
POSTGRES_DB=teamproject
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# CinetPay (Compte Marchand SaaS)
CINETPAY_API_KEY=your_cinetpay_api_key
CINETPAY_SITE_ID=your_cinetpay_site_id

